# AI pattern generation is optional — Dream falls back to an offline
# generator when no key is set. Copy this file to .env and fill in a key
# to enable it.

# Key for whichever OpenAI-compatible provider LLM_BASE_URL points at.
# Free key: https://openrouter.ai/keys
API_KEY=

# Defaults to OpenRouter + a free GLM model. Override both to use a
# different provider, e.g. Gemini's OpenAI-compatible endpoint:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_MODEL=
